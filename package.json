{
	"name": "@oxiul/configs",
	"version": "0.4.1",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oxiul/configs.git"
	},
	"bin": {
		"oxiul": "./dist/bin.mjs"
	},
	"files": [
		"dist/**",
		"scripts/postinstall.mjs"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./workflows": {
			"types": "./dist/workflows/index.d.mts",
			"default": "./dist/workflows/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"changeset": "changeset add",
		"deps": "knip",
		"format": "oxfmt --write",
		"format:verify": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"oxiul:verify": "bun src/bin.ts verify",
		"postinstall": "node scripts/postinstall.mjs",
		"typecheck": "bun check",
		"workflows": "bun src/bin.ts workflows --verify",
		"workflows:generate": "bun src/bin.ts workflows --generate"
	},
	"dependencies": {
		"@crustjs/core": "^0.5.6",
		"@crustjs/extensions": "^0.5.6",
		"@github-actions-workflow-ts/lib": "^2.6.1",
		"cosmiconfig": "^10.0.1",
		"listr2": "^11.4.0",
		"oxlint-plugin-eslint": "^1.88.0",
		"semver": "^7.8.5",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@types/bun": "1.4.3",
		"@types/semver": "^7.8.0",
		"eslint-plugin-better-tailwindcss": "^4.9.1",
		"eslint-plugin-package-json": "^1.10.1",
		"eslint-plugin-playwright": "^2.12.1",
		"knip": "^6.42.0",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"oxlint-tsgolint": "^7.0.2004",
		"publint": "^0.3.25",
		"tsdown": "^0.23.1"
	},
	"peerDependencies": {
		"knip": "^6.42.0",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0"
	},
	"engines": {
		"node": "26"
	},
	"packageManager": "bun@1.4.4"
}
