{
	"name": "@oxiul/workspace",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oxiul/configs.git"
	},
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "bun run --workspaces build",
		"changeset": "changeset add",
		"deps": "knip",
		"format": "oxfmt --write",
		"format:verify": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"oxiul:verify": "bun packages/configs/src/bin.ts verify",
		"postinstall": "node packages/configs/scripts/postinstall.mjs",
		"test": "bun run build && bun test",
		"typecheck": "bun check",
		"workflows": "bun packages/configs/src/bin.ts workflows --verify",
		"workflows:generate": "bun packages/configs/src/bin.ts workflows --generate"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@oxiul/utils": "workspace:*",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@types/bun": "1.4.3",
		"@types/semver": "^7.8.0",
		"eslint-plugin-better-tailwindcss": "^4.9.1",
		"eslint-plugin-package-json": "^1.10.1",
		"eslint-plugin-playwright": "^2.12.1",
		"knip": "^6.42.0",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"oxlint-plugin-eslint": "^1.88.0",
		"oxlint-tsgolint": "^7.0.2004",
		"publint": "^0.3.25",
		"remeda": "^2.54.1",
		"tsdown": "^0.23.1"
	},
	"engines": {
		"node": "26"
	},
	"packageManager": "bun@1.4.4"
}
